---
import { ROLE, type Entry, type Event } from "../../lib/journal";

interface Props {
  entry: Entry;
  event?: Event;
}

const { entry, event } = Astro.props;
const { role, techniques, difficulty, arch, points, source, solver, runLocally } = entry.data;
---

<aside class="marginalia" aria-label="About this entry">
  <dl>
    {
      event && (
        <div>
          <dt>Event</dt>
          <dd>{event.data.name}</dd>
        </div>
      )
    }
    {
      role && (
        <div>
          <dt>Role</dt>
          <dd>{ROLE[role].label}</dd>
        </div>
      )
    }
    {
      techniques.length > 0 && (
        <div>
          <dt>Techniques</dt>
          <dd>
            <ul>
              {techniques.map((technique) => (
                <li>{technique}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
    {
      difficulty && (
        <div>
          <dt>Difficulty</dt>
          <dd>{difficulty}</dd>
        </div>
      )
    }
    {
      arch && (
        <div>
          <dt>Arch</dt>
          <dd>{arch}</dd>
        </div>
      )
    }
    {
      points !== undefined && (
        <div>
          <dt>Points</dt>
          <dd>{points}</dd>
        </div>
      )
    }
    {
      source && (
        <div>
          <dt>Source</dt>
          <dd>
            <a href={source}>Challenge files</a>
            {runLocally && <span class="note">Runs locally</span>}
          </dd>
        </div>
      )
    }
    {
      solver && (
        <div>
          <dt>Solver</dt>
          <dd>
            <a href={solver}>Solve script</a>
          </dd>
        </div>
      )
    }
  </dl>
</aside>

<style>
  dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  dt {
    font: 400 var(--step--2) / 1.3 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dust);
  }

  dd {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ash);
  }

  dd ul {
    list-style: none;
  }

  .note {
    display: block;
    color: var(--dust);
  }

  /* Narrow screens: a strip under the title instead of a margin column. */
  @media (max-width: 63.99rem) {
    .marginalia {
      padding-block: 0.9rem;
      border-block: 1px solid var(--line);
    }

    dl {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 0.75rem 1.25rem;
    }

    dd ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.6rem;
    }
  }
</style>
