---
// The / layer (and Ctrl or ⌘ K). Its index (/search.json) and matcher
// (src/scripts/search.ts) load only when it first opens.
import Corner from "../shell/Corner.astro";

// Quick filters: each fills the field with a word the matcher already understands.
const QUICK = ["projects", "journal", "pwn", "web"];
---

<dialog id="layer-search" class="layer layer-search" aria-labelledby="search-label">
  <Corner class="k tl" />
  <Corner class="k br" />
  <div class="panel">
    <div class="field">
      <label id="search-label" for="search-input" class="visually-hidden">Search</label>
      <span class="prompt" aria-hidden="true">/</span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        autofocus
        placeholder="Search projects, entries, techniques"
        aria-describedby="search-status"
      />
      <kbd>Esc</kbd>
    </div>
    <div class="quick" role="group" aria-label="Quick filters">
      {QUICK.map((word) => <button type="button" class="chip" data-q={word}>{word}</button>)}
    </div>
    <p id="search-status" class="meta" role="status"></p>
    <ol class="results" aria-labelledby="search-label"></ol>
    <p class="meta hint"><kbd>↓</kbd> results · <kbd>Enter</kbd> open · <kbd>Esc</kbd> close</p>
  </div>
</dialog>

<style>
  .layer-search {
    margin-block-start: 12vh;
    width: min(38rem, calc(100% - 2rem));
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.15rem 0.25rem 0.75rem;
    border-bottom: 1px solid var(--edge);
    transition: border-color var(--t-micro) var(--standard);
  }

  .field:focus-within {
    border-color: var(--cloak-deep);
  }

  .prompt {
    font: 400 1.25rem / 1 var(--font-mono);
    color: var(--cloak);
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0;
    border: 0;
    background: none;
    color: var(--soul);
    font: 400 var(--step-1) / 1.3 var(--font-read);
  }

  input::placeholder {
    color: var(--dust);
    opacity: 1;
  }

  input:focus-visible {
    outline: none;
  }

  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quick .chip {
    cursor: pointer;
  }

  .quick .chip:hover {
    color: var(--soul);
    border-color: var(--edge-lit);
  }

  .results {
    display: grid;
    list-style: none;
  }

  .results :global(a) {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    border-left: 2px solid transparent;
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      background-color var(--t-micro) var(--standard),
      border-color var(--t-micro) var(--standard),
      padding-left var(--t-micro) var(--decel);
  }

  .results :global(a:hover),
  .results :global(a:focus-visible) {
    padding-left: 1rem;
    border-left-color: var(--cloak);
    background: var(--raised);
    outline-offset: -2px;
  }

  .results :global(.meta) {
    color: var(--dust);
  }
</style>
