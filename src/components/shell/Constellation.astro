---
// A small star chart that sits between the hero's panels: a hub, six spokes ending in nodes,
// a lantern cap on the top spoke and a vine at the foot. Drawn with the hero's slate blue.
---

<svg class="constellation" viewBox="0 0 120 150" aria-hidden="true" focusable="false">
  <path class="k-arc" d="M60 44 100 40M100 40 106 74M106 74 62 102M62 102 20 76M20 76 16 46M16 46 60 44"></path>
  <path class="k-spoke" d="M60 62V22M60 62 100 40M60 62 106 74M60 62 62 102M60 62 20 76M60 62 16 46"></path>
  <path class="k-cap" d="M60 2 66 9 60 16 54 9ZM54 9H46M66 9H74M60 16V22"></path>
  <circle class="k-ring" cx="60" cy="62" r="11"></circle>
  <path class="k-hub" d="M60 54 68 62 60 70 52 62Z"></path>
  <circle class="k-glow" cx="60" cy="62" r="2.2"></circle>
  <circle class="k-node" cx="100" cy="40" r="3.2"></circle>
  <circle class="k-node" cx="106" cy="74" r="3.2"></circle>
  <circle class="k-node" cx="62" cy="102" r="3.2"></circle>
  <circle class="k-node" cx="20" cy="76" r="3.2"></circle>
  <circle class="k-node" cx="16" cy="46" r="3.2"></circle>
  <circle class="k-node" cx="60" cy="22" r="2.6"></circle>
  <path class="k-vine" d="M20 79C13 92 30 98 25 112S33 132 42 142M25 112c7-2 11 2 12 7"></path>
</svg>

<style>
  .constellation {
    display: block;
    width: 5.5rem;
    height: 6.9rem;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .k-spoke,
  .k-cap,
  .k-ring,
  .k-node {
    stroke: rgb(150 178 214 / 0.65);
    stroke-width: 1;
  }

  .k-arc,
  .k-vine {
    stroke: rgb(150 178 214 / 0.3);
    stroke-width: 0.9;
  }

  .k-arc {
    stroke-dasharray: 2 3;
  }

  .k-node {
    fill: rgb(12 20 34);
  }

  .k-hub {
    fill: rgb(150 178 214 / 0.18);
    stroke: rgb(190 208 232 / 0.8);
    stroke-width: 1;
  }

  .k-glow {
    fill: rgb(220 232 248);
    stroke: none;
    animation: var(--a-breathe) 6s linear infinite;
    animation-play-state: paused;
  }

  :global(body:has([data-live])) .k-glow {
    animation-play-state: running;
  }
</style>
