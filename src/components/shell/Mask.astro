---
// The horned mask: the site's mark, in the header, the footer and the projects banner.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["mask", className]} viewBox="0 0 32 40" aria-hidden="true" focusable="false">
  <path
    class="mask-horns"
    d="M11.5 15.5C9 12 6.2 8 5.6 2.2c3 3.8 5.8 7.2 8.8 10.4ZM20.5 15.5C23 12 25.8 8 26.4 2.2c-3 3.8-5.8 7.2-8.8 10.4Z"
  ></path>
  <path
    class="mask-face"
    fill-rule="evenodd"
    d="M16 11.6c6.6 0 10.6 4.8 10.6 11.4 0 8-4.8 14.6-10.6 14.6S5.4 31 5.4 23c0-6.6 4-11.4 10.6-11.4ZM12.4 19.2c1.9 0 2.6 2.4 2.6 5.2 0 3-1 5-2.6 5s-2.6-2-2.6-5c0-2.8.7-5.2 2.6-5.2Zm7.2 0c1.9 0 2.6 2.4 2.6 5.2 0 3-1 5-2.6 5s-2.6-2-2.6-5c0-2.8.7-5.2 2.6-5.2Z"
  ></path>
</svg>

<style>
  .mask {
    display: block;
    width: auto;
    height: 1.9rem;
    fill: currentColor;
    overflow: visible;
  }
</style>
